[
  {
    "id": "S01",
    "title": "DistServe 原始論文",
    "url": "https://arxiv.org/html/2401.09670v3",
    "scope": "arXiv v3，2024，§2.1",
    "checked": "2026-11-11",
    "summary": "研究把推論分成處理 prompt 與接續生成兩種工作。取用階段定義，不轉用研究環境中的效能數字。",
    "facts": [
      {
        "id": "C01",
        "facet": "prefill",
        "topic": "stages",
        "text": "Prefill 處理輸入的 prompt，建立後續生成所需的狀態，並形成第一個輸出 token。",
        "limit": "這裡介紹自回歸文字生成的概念；不假設服務一定用一整批一次完成 prefill。",
        "locator": "§2.1 LLM Inference",
        "keywords": [
          "prefill",
          "prompt",
          "token",
          "inference",
          "decode"
        ]
      },
      {
        "id": "C02",
        "facet": "decode",
        "topic": "stages",
        "text": "Decode 接續生成後面的 token；後續輸出會依賴先前的上下文與已生成的 token。",
        "limit": "這是自回歸生成的順序關係，不代表每次網路串流都只傳一個 token。",
        "locator": "§2.1 LLM Inference",
        "keywords": [
          "decode",
          "generation",
          "token",
          "prefill"
        ]
      }
    ]
  },
  {
    "id": "S02",
    "title": "vLLM v0.11.0 Metrics 設計",
    "url": "https://docs.vllm.ai/en/v0.11.0/design/metrics.html",
    "scope": "v0.11.0，V1 Design",
    "checked": "2026-11-11",
    "summary": "同一服務可以量到排隊、輸入與輸出區間。必須先指定計時邊界，才可比較數字。",
    "facts": [
      {
        "id": "C03",
        "facet": "queue",
        "topic": "stages",
        "text": "請求到達後可能先等待排程；排隊時間與模型實際處理輸入的時間可以分開觀察。",
        "limit": "不同觀測位置的事件與計時方式可能不同。",
        "locator": "V1 Design → Interval Calculations",
        "keywords": [
          "queue",
          "latency",
          "prefill",
          "schedule"
        ]
      },
      {
        "id": "C04",
        "facet": "ttft",
        "topic": "metrics",
        "text": "首個 token 的等待時間（TTFT），在這裡指服務前端接收請求到收到第一個輸出 token 的時間。",
        "limit": "vLLM v0.11.0 V1 前端量測邊界，包含前端輸入處理與可能的排隊；不是把 prefill 單獨計時。",
        "locator": "V1 Design → Frontend Stats Collection",
        "keywords": [
          "ttft",
          "latency",
          "prefill",
          "queue",
          "token"
        ]
      },
      {
        "id": "C05",
        "facet": "itl",
        "topic": "metrics",
        "text": "相鄰輸出 token 的間隔（ITL）看的是後續 token 到達的節奏。",
        "limit": "不要把相鄰間隔的分布和每個請求的平均 TPOT 當成完全相同的統計量。",
        "locator": "V1 Design → Interval Calculations",
        "keywords": [
          "itl",
          "latency",
          "decode",
          "token"
        ]
      },
      {
        "id": "C06",
        "facet": "e2e",
        "topic": "metrics",
        "text": "這裡的完成時間從服務前端收到請求算到最後一個 token。",
        "limit": "客戶端所見的完成時間還可能包含網路與前端處理，不能混用計時邊界。",
        "locator": "V1 Design → Frontend Stats Collection",
        "keywords": [
          "end-to-end",
          "e2e",
          "latency",
          "completion",
          "token"
        ]
      }
    ]
  },
  {
    "id": "S03",
    "title": "PagedAttention 原始論文",
    "url": "https://arxiv.org/html/2309.06180",
    "scope": "2023，§2.2、§4.1–4.3",
    "checked": "2026-11-11",
    "summary": "KV cache 保存先前 token 的注意力狀態。原論文用區塊管理這些資料，避免為每個請求預留整段連續空間。",
    "facts": [
      {
        "id": "C07",
        "facet": "kv-state",
        "topic": "kv",
        "text": "KV cache 保存先前 token 已算出的注意力 key、value，讓後續生成可以使用這些狀態。",
        "limit": "保存的是模型中間狀態，不是把整篇已生成的回答當作快取結果。",
        "locator": "§2.2 與 §4.3",
        "keywords": [
          "kv",
          "cache",
          "token",
          "decode",
          "state"
        ]
      },
      {
        "id": "C08",
        "facet": "block-memory",
        "topic": "kv",
        "text": "PagedAttention 把 KV cache 以區塊管理，可隨序列長度配置，區塊不必在記憶體中連續。",
        "limit": "原論文設計；這個機制本身不保證特定請求會降低固定比例延遲。",
        "locator": "§4.1–4.2",
        "keywords": [
          "kv",
          "cache",
          "token",
          "blocks",
          "memory"
        ]
      }
    ]
  },
  {
    "id": "S04",
    "title": "vLLM v0.11.0 Automatic Prefix Caching",
    "url": "https://docs.vllm.ai/en/v0.11.0/features/automatic_prefix_caching.html",
    "scope": "v0.11.0，Introduction／Limits",
    "checked": "2026-11-11",
    "summary": "相同前綴的可用 KV 狀態可以跨請求重用。需要區分輸入計算節省與新 token 的生成。",
    "facts": [
      {
        "id": "C09",
        "facet": "prefix-reuse",
        "topic": "prefix",
        "text": "自動前綴快取（APC）讓新請求重用相同前綴的可用 KV 狀態，減少該段 prefill 的重複計算。",
        "limit": "須有相容且仍可用的共同前綴；示例不代表全程都命中。",
        "locator": "Introduction／Example workloads",
        "keywords": [
          "prefix",
          "cache",
          "prefill",
          "kv",
          "reuse"
        ]
      },
      {
        "id": "C10",
        "facet": "decode-limit",
        "topic": "prefix",
        "text": "APC 減少共同前綴的輸入處理工作，並不直接縮短後續每個新 token 的 decode 計算。",
        "limit": "不能由 APC 命中推出 ITL 必然下降，也不能推估固定延遲改善比例。",
        "locator": "Limits",
        "keywords": [
          "prefix",
          "cache",
          "prefill",
          "decode",
          "latency",
          "ttft",
          "itl"
        ]
      },
      {
        "id": "C11",
        "facet": "cache-bound",
        "topic": "prefix",
        "text": "沒有可重用前綴時，不能靠該段快取省下計算；若等待主要來自長輸出，整體改善也可能有限。",
        "limit": "實際效果取決於工作負載、排程與快取狀態。",
        "locator": "Limits",
        "keywords": [
          "prefix",
          "cache",
          "latency",
          "output",
          "workload"
        ]
      }
    ]
  },
